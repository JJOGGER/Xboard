{
  "name": "@xboard/user",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run --dir src/__tests__/unit",
    "test:property": "vitest run --dir src/__tests__/property",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "@xboard/shared": "workspace:*",
    "axios": "^1.6.5",
    "chart.js": "^4.4.1",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "naive-ui": "^2.37.3",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.3",
    "vee-validate": "^4.12.4",
    "vue": "^3.4.15",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^9.9.0",
    "vue-router": "^4.2.5",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/ui": "^4.0.17",
    "@vue/test-utils": "^2.4.3",
    "autoprefixer": "^10.4.17",
    "fast-check": "^3.15.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^4.0.17",
    "vue-tsc": "^2.0.0"
  }
}
